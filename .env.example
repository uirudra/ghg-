# MongoDB Atlas (free 512MB cluster). Percent-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=ghg_nexus

# GroqCloud (fast copilot provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (second-opinion / long-form provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# API
API_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
